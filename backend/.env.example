# Porta em que a API Express roda na sua maquina (http://localhost:3000)
PORT=3000

# Chave usada para assinar os tokens JWT (troque por um texto secreto)
JWT_SECRET=troque_este_valor_por_uma_chave_secreta_forte

# Conexao com o MongoDB. NAO e a porta: e o endereco do banco.
# MongoDB Atlas (nuvem):
MONGO_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/dominio-store?retryWrites=true&w=majority
# MongoDB instalado no seu PC (alternativa):
# MONGO_URI=mongodb://127.0.0.1:27017/dominio-store

# Conta de administrador criada pelo comando: npm run criar-admin
ADMIN_EMAIL=admin@dominio.com
ADMIN_SENHA=admin123
